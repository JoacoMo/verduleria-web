# Base de datos (Postgres en Supabase).
#
# Runtime: pooler de Supabase (Supavisor) en modo transacción, puerto 6543.
# - pgbouncer=true: Prisma no usa prepared statements con nombre, que el modo
#   transacción no soporta (cada consulta puede caer en otra conexión real).
# - connection_limit=1: en Vercel cada instancia serverless abre su propio pool
#   y puede haber muchas a la vez. Con una conexión por instancia no se agotan
#   las conexiones de Postgres: el que multiplexa es el pooler.
# - sslmode=require: la conexión va cifrada.
DATABASE_URL="postgresql://postgres.TU_PROYECTO:tu_password@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1&sslmode=require"

# Migraciones (prisma migrate): pooler en modo sesión, puerto 5432.
DIRECT_URL="postgresql://postgres.TU_PROYECTO:tu_password@aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=require"

# Login del panel de administración. Usá una contraseña larga (16+ caracteres):
# es la única barrera del panel. El login no acepta los valores de ejemplo
# de versiones viejas de este archivo.
ADMIN_USERNAME="admin"
ADMIN_PASSWORD=""

# Frase secreta para firmar las sesiones del panel (texto largo y random, 32+ caracteres)
# Generalo con: openssl rand -base64 48
JWT_SECRET=""

# Versión de las sesiones del panel. Cambiarla (ej. de "1" a "2") y hacer
# Redeploy en Vercel (las variables nuevas solo aplican a deploys nuevos) cierra
# todas las sesiones abiertas: usarla si cambiás la contraseña o se pierde un
# celular con el panel abierto.
ADMIN_TOKEN_VERSION="1"

# Secreto de la limpieza diaria de pedidos (/api/cron/limpiar-pedidos).
# Vercel lo manda solo en "Authorization: Bearer ..." cuando corre el cron.
# Sin esta variable la limpieza no corre. Texto largo y random.
# Generalo con: openssl rand -base64 48
CRON_SECRET=""

# Datos del negocio (aparecen en la web y en los mensajes de WhatsApp).
# Los horarios NO van acá: están en src/lib/store-hours.ts.
STORE_NAME="El Pampa"
STORE_ADDRESS="Rosario de Santa Fe 1211, Barrio General Paz, Córdoba Capital"
STORE_NEIGHBORHOOD="Barrio General Paz"
SITE_URL="https://elpampa.vercel.app"
CONTACT_EMAIL="contacto@ejemplo.com"

# Datos para que el cliente transfiera (el pago se confirma a mano desde el panel)
TRANSFER_ALIAS="mi.verduleria.alias"
TRANSFER_CBU="0000000000000000000000"
WHATSAPP_NUMBER="5490000000000"

# Envíos a domicilio (turnos de 13 a 14 h y de 19 a 20 h, ver src/lib/delivery-slots.ts).
# Costo fijo del envío.
DELIVERY_FEE="4000"
# Desde este subtotal (sin el envío) el envío es gratis.
DELIVERY_FREE_THRESHOLD="20000"
# Subtotal mínimo para pedir con envío (no aplica a retiro en el local).
DELIVERY_MIN_PURCHASE="10000"
# Peso orientativo a partir del cual un envío puede necesitar dos viajes.
DELIVERY_MAX_WEIGHT_KG="7"

# Supabase Storage para imágenes de productos
SUPABASE_URL="https://xxxxx.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="tu-service-role-key"
SUPABASE_STORAGE_BUCKET="product-images"

# Solo para scripts/fill-product-images.js (opcional).
# API key gratis en https://www.pexels.com/api/
PEXELS_API_KEY="tu-pexels-api-key"

# URL del perfil de Instagram (si queda vacía, el menú no muestra el botón)
INSTAGRAM_URL=""
# Link corto para dejar reseña en Google (Perfil de empresa > "Pedir reseñas").
# Si queda vacío, no se le pide la reseña al cliente después de comprar.
GOOGLE_REVIEW_URL=""
