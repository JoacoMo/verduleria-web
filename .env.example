# Base de datos (Postgres).
# Runtime: pooler transaction mode.
DATABASE_URL="postgresql://postgres.TU_PROYECTO:tu_password@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&sslmode=require"

# Migrations / direct connection: pooler session mode.
DIRECT_URL="postgresql://postgres.TU_PROYECTO:tu_password@aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=require"

# Login del panel de administración (elegí vos usuario y contraseña)
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="cambiar-esta-clave"

# Frase secreta para firmar los tokens de sesión del admin (texto largo y random)
JWT_SECRET="cambiar-por-un-texto-largo-y-random"

# Nombre del negocio (aparece en mensajes de WhatsApp y en la web)
STORE_NAME="El Pampa"
STORE_ADDRESS="Barrio General Paz, Córdoba Capital"
STORE_NEIGHBORHOOD="Barrio General Paz"
SITE_URL="https://elpampa.vercel.app"
STORE_WEEKDAY_HOURS="Lunes a sábado de 8:00 a 14:00 y de 17:30 a 21:30"
STORE_SUNDAY_HOURS="Domingos de 9:00 a 14:00"

# Datos para que el cliente transfiera y vos confirmes el pago a mano
TRANSFER_ALIAS="mi.verduleria.alias"
TRANSFER_CBU="0000000000000000000000"
WHATSAPP_NUMBER="5490000000000"

# Envíos (coordinados a mano por WhatsApp, no hay integración con una API de delivery).
# Se usan para el aviso de variabilidad de precio/tiempo, el límite de peso sugerido
# y el pedido mínimo para pedidos con envío (no aplica a retiro en el local).
DELIVERY_PROVIDER_NAME="Uber Moto"
DELIVERY_MAX_WEIGHT_KG="7"
DELIVERY_MIN_PURCHASE="10000"
# A partir de este total el envío no se le cobra al cliente
DELIVERY_FREE_THRESHOLD="20000"

# Supabase Storage para imágenes de productos
SUPABASE_URL="https://xxxxx.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="tu-service-role-key"
SUPABASE_STORAGE_BUCKET="product-images"

# Solo para scripts/fill-product-images.js (opcional).
# API key gratis en https://www.pexels.com/api/
PEXELS_API_KEY="tu-pexels-api-key"

# Mercado Pago (Checkout Pro). Si MP_ACCESS_TOKEN está vacío, la tienda
# solo ofrece transferencia y el botón de tarjeta no aparece.
# Se sacan de https://www.mercadopago.com.ar/developers/panel/app
MP_ACCESS_TOKEN=""
# Secreto de la firma del webhook (panel de MP > Webhooks > Configurar notificaciones)
MP_WEBHOOK_SECRET=""
# URL del perfil de Instagram (si queda vacía, el menú no muestra el botón)
INSTAGRAM_URL=""
# Link corto para dejar reseña en Google (Perfil de empresa > "Pedir reseñas").
# Si queda vacío, no se le pide la reseña al cliente después de comprar.
GOOGLE_REVIEW_URL=""
