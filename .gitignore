# Ignorar dependencias de Node, se pueden reinstalar con npm install
node_modules
.next

# Variables de entorno: cualquier .env (incluido el .env.local que genera
# `vercel env pull`) menos el de ejemplo. Contienen la contraseña de la BD, la
# service role key de Supabase y el secreto de las sesiones.
.env*
!.env.example

# Vercel CLI (vercel link)
.vercel

# Márgenes reales del negocio para el script de precios (el ejemplo sí va al repo)
scripts/precios/margenes.json

# Configuración local de Claude Code (permisos específicos de la máquina/sesión)
.claude/settings.local.json

# Herramientas de agentes / build local
.agents/
.claude/skills/
.claude/settings.local.json
.mcp.json
skills-lock.json
tsconfig.tsbuildinfo

# Script de precios: reportes y logs locales
scripts/precios/reportes/
scripts/precios/logs/
__pycache__/
*.pyc

# Tests: reportes de cobertura y caché de Vitest
coverage/
.vitest/
