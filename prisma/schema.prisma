generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Product {
  id        Int      @id @default(autoincrement())
  name      String
  price     Float
  image     String
  unit      String   @default("kg")
  category  String   @default("Almacén")
  // Lo maneja el dueño desde el panel. Los que están en false se muestran
  // al final de la tienda y no se pueden agregar al carrito.
  available Boolean  @default(true)
  createdAt DateTime @default(now())
}

model Order {
  id             Int      @id @default(autoincrement())
  items          Json // [{ id, name, price, quantity }]
  total          Float
  status         String   @default("pending") // pending | paid | failed
  deliveryMethod String   @default("pickup") // pickup | delivery
  mpPreferenceId String?
  mpPaymentId    String?
  customerName   String?
  customerPhone  String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([createdAt])
}
